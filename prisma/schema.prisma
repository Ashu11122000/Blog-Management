// Prisma Schema
// Blog Management System
// Prisma 7.x
// PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  AUTHOR
  USER
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id          String      @id @default(cuid())
  name        String
  email       String      @unique
  password    String
  image       String?

  role        UserRole    @default(USER)

  posts       Post[]
  comments    Comment[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("users")
}

model Category {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String?

  posts       Post[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("categories")
}

model Tag {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique

  posts       PostTag[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("tags")
}

model Post {
  id              String       @id @default(cuid())

  title           String
  slug            String       @unique

  excerpt         String?
  content         String

  featuredImage   String?

  publishedAt     DateTime?

  status          PostStatus   @default(DRAFT)

  authorId        String
  author          User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  categoryId      String
  category        Category     @relation(fields: [categoryId], references: [id])

  tags            PostTag[]

  comments        Comment[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([authorId])
  @@index([categoryId])
  @@index([slug])
  @@map("posts")
}

model PostTag {
  postId      String
  tagId       String

  post        Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag         Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Comment {
  id          String      @id @default(cuid())

  content     String

  postId      String
  post        Post        @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([postId])
  @@index([userId])
  @@map("comments")
}